{
  "name": "purple-dragon-powertools",
  "version": "2.1.0",
  "description": "Purple Dragon PowerTools - Windows system utility and AI command center by Purple Dragon Foundation Ltd, currently in v2.1.0 public-release readiness.",
  "main": "src/main.js",
  "author": "Purple Dragon Foundation Ltd",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "verify:syntax": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist:win": "electron-builder --win nsis portable",
    "pack:win": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.kyleaustin85.purpledragonpowertools",
    "productName": "Purple Dragon PowerTools",
    "asar": true,
    "files": [
      "src/**/*",
      "!src/vendor/sensor-bridge/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "src/assets/purple-dragon-foundation-mark.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Purple Dragon PowerTools",
      "artifactName": "Purple-Dragon-PowerTools-Setup-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "src/vendor/sensor-bridge",
        "to": "sensor-bridge"
      }
    ],
    "copyright": "Copyright © 2026 Purple Dragon Foundation Ltd",
    "portable": {
      "artifactName": "Purple-Dragon-PowerTools-Portable-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
