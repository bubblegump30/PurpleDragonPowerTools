{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bubblegump30/PurpleDragonPowerTools/blob/main/release-manifest.schema.json",
  "title": "Purple Dragon PowerTools Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "version",
    "channel",
    "publishedAt",
    "repository",
    "commit",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "Purple Dragon PowerTools"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": [
        "stable",
        "preview"
      ]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "bubblegump30/PurpleDragonPowerTools"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "minimumVersion": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "releaseNotesUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "installer",
              "portable",
              "archive",
              "other"
            ]
          }
        }
      }
    },
    "signature": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "file"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "ssh-ed25519",
            "minisign-ed25519",
            "authenticode"
          ]
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    }
  }
}
